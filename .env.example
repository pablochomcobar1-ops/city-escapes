# Copy to .env.local and fill in. Never commit .env.local.
# WhatsApp number for the "Chat on WhatsApp" button: country code + number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
# Public address of the site once deployed (for share previews, sitemap, robots), no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
